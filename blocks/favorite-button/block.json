{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/favorite-button",
	"title": "Favorite Button",
	"category": "easyq",
	"description": "Adds the current question, user, tag or category to the favorites of the visitor.",
	"keywords": [
		"favorite",
		"follow",
		"bookmark"
	],
	"textdomain": "easyq",
	"usesContext": [
		"easyq/postId",
		"easyq/userId"
	],
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"viewScriptModule": "easyq-view",
	"style": [
		"wp-block-buttons",
		"wp-block-button"
	]
}
