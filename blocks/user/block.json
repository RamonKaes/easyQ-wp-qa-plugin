{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/user",
	"title": "User",
	"category": "easyq",
	"description": "Shows a user with the blocks inside: the user of the profile page or a chosen user.",
	"textdomain": "easyq",
	"attributes": {
		"userId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true
		},
		"layout": true
	},
	"example": {},
	"editorScript": "easyq-editor"
}
