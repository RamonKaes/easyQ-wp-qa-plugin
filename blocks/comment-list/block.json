{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/comment-list",
	"title": "Comment List",
	"category": "easyq",
	"description": "The comments on a question or answer.",
	"keywords": [
		"comments",
		"replies",
		"list"
	],
	"textdomain": "easyq",
	"usesContext": [
		"easyq/postId"
	],
	"attributes": {
		"showFewerFrom": {
			"type": "number",
			"default": 0,
			"minimum": 0,
			"maximum": 100
		},
		"showFewerCount": {
			"type": "number",
			"default": 0,
			"minimum": 0,
			"maximum": 100
		}
	},
	"providesContext": {
		"easyq/commentsFewerFrom": "showFewerFrom",
		"easyq/commentsFewerCount": "showFewerCount"
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"layout": true
	},
	"editorScript": "easyq-editor"
}
