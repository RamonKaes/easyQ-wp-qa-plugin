{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/answer-form",
	"title": "Answer Form",
	"category": "easyq",
	"description": "Form to answer the question.",
	"keywords": [
		"answer",
		"reply",
		"form"
	],
	"textdomain": "easyq",
	"attributes": {
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"level": {
			"type": "number",
			"default": 2,
			"minimum": 1,
			"maximum": 6
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"interactivity": true
	},
	"editorScript": "easyq-editor",
	"viewScriptModule": "easyq-view",
	"style": "wp-block-post-comments-form"
}
