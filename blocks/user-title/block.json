{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/user-title",
	"title": "User Title",
	"category": "easyq",
	"description": "The title of a user, from their level or points.",
	"textdomain": "easyq",
	"usesContext": [
		"easyq/userId"
	],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"render": "file:./render.php"
}
