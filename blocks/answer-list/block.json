{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/answer-list",
	"title": "Answer List",
	"category": "easyq",
	"description": "The answers of a question.",
	"textdomain": "easyq",
	"attributes": {
		"queryId": {
			"type": "number"
		},
		"order": {
			"type": "string",
			"enum": [
				"",
				"votes",
				"created"
			],
			"default": ""
		},
		"selectedFirst": {
			"type": "string",
			"enum": [
				"",
				"yes",
				"no"
			],
			"default": ""
		},
		"perPage": {
			"type": "number",
			"default": 0
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"providesContext": {
		"easyq/listId": "queryId",
		"easyq/answerOrder": "order",
		"easyq/answerSelectedFirst": "selectedFirst",
		"easyq/answersPerPage": "perPage"
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true
		},
		"layout": true
	},
	"editorScript": "easyq-editor",
	"render": "file:./render.php"
}
