{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/answer-list",
	"title": "Answer List",
	"category": "easyq",
	"description": "The answers of a question.",
	"keywords": [
		"answers",
		"replies",
		"list"
	],
	"textdomain": "easyq",
	"attributes": {
		"queryId": {
			"type": "number"
		},
		"order": {
			"type": "string",
			"enum": [
				"",
				"votes",
				"created"
			],
			"default": ""
		},
		"selectedFirst": {
			"type": "string",
			"enum": [
				"",
				"yes",
				"no"
			],
			"default": ""
		},
		"perPage": {
			"type": "number",
			"default": 0,
			"minimum": 0,
			"maximum": 100
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"level": {
			"type": "number",
			"default": 2,
			"minimum": 1,
			"maximum": 6
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"providesContext": {
		"easyq/listId": "queryId",
		"easyq/answerOrder": "order",
		"easyq/answerSelectedFirst": "selectedFirst",
		"easyq/answersPerPage": "perPage"
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"layout": true
	},
	"example": {},
	"editorScript": "easyq-editor"
}
