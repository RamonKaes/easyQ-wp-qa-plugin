{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/answer-list",
	"title": "Answer List",
	"category": "easyq",
	"description": "The answers of a question.",
	"textdomain": "easyq",
	"attributes": {
		"queryId": {
			"type": "number"
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"providesContext": {
		"easyq/listId": "queryId"
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true
		},
		"layout": true
	},
	"editorScript": "easyq-editor",
	"render": "file:./render.php"
}
