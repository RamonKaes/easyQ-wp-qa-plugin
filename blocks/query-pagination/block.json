{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/query-pagination",
	"title": "Q&A Pagination",
	"category": "easyq",
	"description": "Links to the other pages of a question or answer list.",
	"textdomain": "easyq",
	"attributes": {
		"showNumbers": {
			"type": "boolean",
			"default": true
		},
		"arrow": {
			"type": "string",
			"enum": [
				"none",
				"arrow",
				"chevron"
			],
			"default": "none"
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		}
	},
	"usesContext": [
		"easyq/listId"
	],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"style": "wp-block-query-pagination"
}
