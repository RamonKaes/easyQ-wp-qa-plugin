{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/query-pagination",
	"title": "Q&A Pagination",
	"category": "easyq",
	"ancestor": [
		"easyq/question-query",
		"easyq/answer-list",
		"easyq/user-query"
	],
	"description": "Links to the other pages of a question or answer list.",
	"keywords": [
		"pagination",
		"pages",
		"next",
		"previous"
	],
	"textdomain": "easyq",
	"attributes": {
		"showNumbers": {
			"type": "boolean",
			"default": true
		},
		"arrow": {
			"type": "string",
			"enum": [
				"none",
				"arrow",
				"chevron"
			],
			"default": "none"
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		},
		"midSize": {
			"type": "number",
			"default": 2,
			"minimum": 0,
			"maximum": 5
		}
	},
	"usesContext": [
		"easyq/listId"
	],
	"supports": {
		"anchor": true,
		"html": false,
		"align": true,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "flex"
			}
		}
	},
	"editorScript": "easyq-editor",
	"style": "wp-block-query-pagination"
}
