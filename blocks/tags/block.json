{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/tags",
	"title": "Q&A Tags",
	"category": "easyq",
	"description": "Popular tags, linked to their questions.",
	"keywords": [
		"tags",
		"tag cloud",
		"popular"
	],
	"textdomain": "easyq",
	"attributes": {
		"perPage": {
			"type": "number",
			"default": 0,
			"minimum": 0,
			"maximum": 100
		},
		"showCounts": {
			"type": "boolean",
			"default": true
		},
		"favorites": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": true,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"layout": {
			"default": {
				"type": "flex",
				"flexWrap": "wrap"
			},
			"allowSwitching": false,
			"allowInheriting": false,
			"allowOrientation": true
		}
	},
	"example": {},
	"editorScript": "easyq-editor"
}
