{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/question",
	"title": "Question",
	"category": "easyq",
	"description": "Shows the question of the current page; the blocks inside show its parts.",
	"textdomain": "easyq",
	"attributes": {
		"questionId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true
		},
		"layout": true,
		"interactivity": true
	},
	"example": {},
	"editorScript": "easyq-editor",
	"viewScriptModule": "easyq-view",
	"render": "file:./render.php"
}
