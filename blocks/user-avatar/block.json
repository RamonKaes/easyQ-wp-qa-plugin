{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/user-avatar",
	"title": "User Avatar",
	"category": "easyq",
	"description": "The avatar of a user.",
	"textdomain": "easyq",
	"attributes": {
		"avatarSize": {
			"type": "number",
			"default": 96
		},
		"isLink": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"easyq/userId"
	],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"render": "file:./render.php"
}
