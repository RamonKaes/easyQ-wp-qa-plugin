{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/notices",
	"title": "Q&A Notices",
	"category": "easyq",
	"description": "Messages after submitting a form and hints for visitors.",
	"textdomain": "easyq",
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true
	},
	"editorScript": "easyq-editor",
	"viewScriptModule": "easyq-view",
	"render": "file:./render.php"
}
