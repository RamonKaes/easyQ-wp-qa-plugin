{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/post-votes",
	"title": "Votes",
	"category": "easyq",
	"description": "Vote count with buttons to vote up and down.",
	"textdomain": "easyq",
	"attributes": {
		"display": {
			"type": "string",
			"enum": [
				"",
				"net",
				"separated"
			],
			"default": ""
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true,
		"layout": {
			"default": {
				"type": "flex",
				"flexWrap": "nowrap",
				"orientation": "horizontal",
				"verticalAlignment": "center"
			},
			"allowSwitching": false,
			"allowInheriting": false,
			"allowOrientation": true
		}
	},
	"editorScript": "easyq-editor",
	"viewScriptModule": "easyq-view",
	"style": [
		"wp-block-buttons",
		"wp-block-button"
	]
}
