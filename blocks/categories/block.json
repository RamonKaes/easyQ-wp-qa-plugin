{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/categories",
	"title": "Q&A Categories",
	"category": "easyq",
	"description": "Categories with the number of questions.",
	"textdomain": "easyq",
	"attributes": {
		"showCounts": {
			"type": "boolean",
			"default": true
		},
		"showChildrenOfCurrent": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"render": "file:./render.php"
}
