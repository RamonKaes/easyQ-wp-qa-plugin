{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/user-query",
	"title": "User List",
	"category": "easyq",
	"description": "A list of users with its own layout: top users by points, newest users or users with special levels.",
	"keywords": [
		"users",
		"members",
		"list",
		"leaderboard"
	],
	"textdomain": "easyq",
	"attributes": {
		"queryId": {
			"type": "number"
		},
		"query": {
			"type": "object",
			"default": {
				"sort": "points",
				"perPage": 0,
				"inherit": true
			}
		}
	},
	"providesContext": {
		"easyq/listId": "queryId",
		"easyq/userQuery": "query"
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"align": [
			"wide",
			"full"
		],
		"layout": true
	},
	"example": {
		"attributes": {
			"query": {
				"sort": "points",
				"perPage": 3,
				"inherit": false
			}
		}
	},
	"variations": [
		{
			"name": "points",
			"title": "Top Users",
			"description": "Users with the most points, or the sort order of the current page.",
			"isDefault": true,
			"attributes": {
				"query": {
					"sort": "points",
					"perPage": 0,
					"inherit": true
				}
			},
			"keywords": [
				"top",
				"points",
				"leaderboard"
			],
			"isActive": [
				"query.sort"
			],
			"scope": [
				"inserter",
				"transform"
			]
		},
		{
			"name": "newest",
			"title": "Newest Users",
			"description": "The users who joined last.",
			"attributes": {
				"query": {
					"sort": "newest",
					"perPage": 0,
					"inherit": false
				}
			},
			"keywords": [
				"newest",
				"new",
				"members"
			],
			"isActive": [
				"query.sort"
			],
			"scope": [
				"inserter",
				"transform"
			]
		},
		{
			"name": "special",
			"title": "Special Users",
			"description": "Experts, editors, moderators and administrators.",
			"attributes": {
				"query": {
					"sort": "special",
					"perPage": 0,
					"inherit": false
				}
			},
			"keywords": [
				"special",
				"moderators",
				"staff"
			],
			"isActive": [
				"query.sort"
			],
			"scope": [
				"inserter",
				"transform"
			]
		},
		{
			"name": "favorites",
			"title": "Favorite Users",
			"description": "The users the visitor added to their favorites.",
			"attributes": {
				"query": {
					"sort": "favorites",
					"perPage": 0,
					"inherit": false
				}
			},
			"keywords": [
				"favorites",
				"following",
				"saved"
			],
			"isActive": [
				"query.sort"
			],
			"scope": [
				"inserter",
				"transform"
			]
		}
	],
	"editorScript": "easyq-editor"
}
