{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/question-query",
	"title": "Question List",
	"category": "easyq",
	"description": "A list of questions with its own layout. Shows the questions of the current page or a fixed selection.",
	"textdomain": "easyq",
	"attributes": {
		"queryId": {
			"type": "number"
		},
		"query": {
			"type": "object",
			"default": {
				"source": "recent",
				"category": 0,
				"tag": "",
				"perPage": 0,
				"inherit": true
			}
		}
	},
	"providesContext": {
		"easyq/listId": "queryId",
		"easyq/query": "query"
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true
		},
		"align": [
			"wide",
			"full"
		],
		"layout": true
	},
	"example": {
		"attributes": {
			"query": {
				"source": "recent",
				"perPage": 2,
				"inherit": false
			}
		}
	},
	"editorScript": "easyq-editor"
}
