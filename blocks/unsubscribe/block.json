{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/unsubscribe",
	"title": "Stop Emails",
	"category": "easyq",
	"description": "Form to stop the emails about a post, opened from a link in such an email.",
	"textdomain": "easyq",
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"style": [
		"wp-block-buttons",
		"wp-block-button",
		"wp-block-post-comments-form"
	]
}
