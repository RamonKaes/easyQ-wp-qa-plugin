{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/activity-count",
	"title": "Q&A Statistics",
	"category": "easyq",
	"description": "Numbers of questions, answers, comments and users.",
	"textdomain": "easyq",
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"layout": {
			"default": {
				"type": "flex",
				"flexWrap": "wrap"
			},
			"allowSwitching": false,
			"allowInheriting": false,
			"allowOrientation": true
		}
	},
	"example": {},
	"editorScript": "easyq-editor",
	"render": "file:./render.php"
}
