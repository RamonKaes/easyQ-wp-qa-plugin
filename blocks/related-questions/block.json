{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/related-questions",
	"title": "Related Questions",
	"category": "easyq",
	"description": "Questions similar to the current question.",
	"keywords": [
		"related",
		"similar",
		"questions"
	],
	"textdomain": "easyq",
	"attributes": {
		"count": {
			"type": "number",
			"default": 5,
			"minimum": 1,
			"maximum": 100
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"level": {
			"type": "number",
			"default": 2,
			"minimum": 1,
			"maximum": 6
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"example": {},
	"editorScript": "easyq-editor",
	"style": "wp-block-latest-posts"
}
