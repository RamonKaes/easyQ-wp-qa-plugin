{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/related-questions",
	"title": "Related Questions",
	"category": "easyq",
	"description": "Questions similar to the current question.",
	"textdomain": "easyq",
	"attributes": {
		"count": {
			"type": "number",
			"default": 5
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"render": "file:./render.php"
}
