{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easyq/post-tags",
	"title": "Question Tags",
	"category": "easyq",
	"description": "Tags of a question, linked to their pages.",
	"textdomain": "easyq",
	"attributes": {
		"separator": {
			"type": "string",
			"default": ", "
		}
	},
	"usesContext": [
		"easyq/postId"
	],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "easyq-editor",
	"style": "wp-block-post-terms",
	"render": "file:./render.php"
}
