<?xml version="1.0"?>
<ruleset name="easyQ">
	<description>WordPress Coding Standards for easyQ.</description>

	<file>.</file>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="easyq"/>
			</property>
		</properties>
	</rule>

	<!-- Meta capabilities resolved in EasyQ\Capabilities. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="easyq_manage"/>
				<element value="easyq_moderate"/>
				<element value="easyq_view_questions"/>
				<element value="easyq_post_question"/>
				<element value="easyq_edit_silently"/>
				<element value="easyq_view_ips"/>
				<element value="easyq_view_voters"/>
				<element value="easyq_post_wall"/>
				<element value="easyq_view_new_users"/>
				<element value="easyq_view_special_users"/>
				<element value="easyq_post_answer"/>
				<element value="easyq_post_comment"/>
				<element value="easyq_edit_post"/>
				<element value="easyq_retag_question"/>
				<element value="easyq_select_answer"/>
				<element value="easyq_flag_post"/>
				<element value="easyq_clear_flags"/>
				<element value="easyq_close_question"/>
				<element value="easyq_reopen_question"/>
				<element value="easyq_moderate_post"/>
				<element value="easyq_hide_post"/>
				<element value="easyq_reshow_post"/>
				<element value="easyq_delete_post"/>
				<element value="easyq_vote_post"/>
				<element value="easyq_vote_down_post"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="easyq"/>
			</property>
		</properties>
	</rule>

	<!-- Test classes follow the PHPUnit conventions (class and method names, file names). -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Like WordPress core: test methods are documented by their names, and tests query the database directly. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
