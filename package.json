{
	"name": "easyq",
	"version": "0.1.0",
	"private": true,
	"description": "Question and answer platform for WordPress, based on Question2Answer.",
	"author": "easyQ",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"question-answer",
		"q-and-a",
		"blocks"
	],
	"homepage": "https://easyq.info",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RamonKaes/easyQ-wp-qa-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/RamonKaes/easyQ-wp-qa-plugin/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"easyq.php",
		"uninstall.php",
		"includes",
		"blocks",
		"build",
		"src",
		"languages",
		"readme.txt",
		"LICENSE"
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/interactivity": "^7.0.0",
		"@wordpress/scripts": "^36.1.0",
		"@wordpress/server-side-render": "^6.33.0",
		"@wordpress/url": "^4.57.0"
	},
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"start": "wp-scripts start --experimental-modules",
		"lint:js": "wp-scripts lint-js",
		"lint:md": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"i18n:pot": "wp-env run cli wp i18n make-pot wp-content/plugins/$(basename \"$PWD\") wp-content/plugins/$(basename \"$PWD\")/languages/easyq.pot --exclude=vendor,node_modules,tests,artifacts,docs,build",
		"format": "wp-scripts format",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/$(basename \"$PWD\") vendor/bin/phpunit",
		"test:php:multisite": "wp-env run tests-cli --env-cwd=wp-content/plugins/$(basename \"$PWD\") vendor/bin/phpunit -c phpunit-multisite.xml.dist",
		"test:e2e": "wp-scripts test-playwright",
		"plugin-zip": "wp-scripts plugin-zip",
		"plugin-check": "wp-env run cli wp plugin check $(basename \"$PWD\") --exclude-directories=vendor,node_modules,tests,artifacts,docs,bin --exclude-files=composer.json,composer.lock,package.json,package-lock.json,phpcs.xml.dist,phpstan.neon.dist,phpunit.xml.dist,phpunit-unit.xml.dist,phpunit-multisite.xml.dist,playwright.config.js,webpack.config.js,.wp-env.json,.editorconfig,.gitattributes,.gitignore,.phpcs-cache,.phpunit.result.cache"
	}
}
